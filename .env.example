# Token entregado por @BotFather
TELEGRAM_TOKEN=

# ID numérico del grupo o supergrupo, normalmente empieza por -100
GROUP_ID=-1001234567890

# Nombre visible del grupo y servidor
GROUP_NAME=GAMAER CITY

# IDs numéricos de administradores iniciales separados por comas
ADMIN_IDS=123456789

# Carpeta persistente para JSON, logs de moderación y configuración
DATA_DIR=./data

# INFO, WARNING o DEBUG
LOG_LEVEL=INFO
