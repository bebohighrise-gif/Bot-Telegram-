# Obligatorio: token de @BotFather
TELEGRAM_TOKEN=

# Obligatorio: ID numérico del grupo o supergrupo
GROUP_ID=-1001234567890

# Opcional: nombre visible del grupo y servidor
GROUP_NAME=GAMAER CITY

# Opcional: IDs iniciales separados por comas. Puede quedar vacío.
# Si queda vacío, el propietario del grupo usa /claimadmin en privado.
ADMIN_IDS=

# Carpeta persistente para los archivos JSON
DATA_DIR=./data

# INFO, WARNING o DEBUG
LOG_LEVEL=INFO
